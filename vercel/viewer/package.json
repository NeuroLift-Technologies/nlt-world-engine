{
  "name": "@nlt/world-engine-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Spectator viewer for the NLT World Engine: the Godot world rebuilt in the browser, driven by nlt.state-feed.v1 replays (static, no backend)",
  "scripts": {
    "sync-assets": "node scripts/sync-godot-assets.mjs",
    "predev": "node scripts/sync-godot-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/sync-godot-assets.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "22.12.0",
    "@types/three": "~0.181.0",
    "typescript": "~5.7.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@vercel/sandbox": "3.9.1",
    "three": "^0.181.2"
  }
}
