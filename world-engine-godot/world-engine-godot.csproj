<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AssemblyName>NLT World Engine (Godot)</AssemblyName>
    <RootNamespace>NltWorldEngine</RootNamespace>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    AgentHarness/ is a standalone out-of-engine test runner with its own csproj. Exclude it from
    the Godot project's default **/*.cs glob so its sources (and Main entry point) are never
    compiled into the Godot assembly. Build/run it via: dotnet run -Project AgentHarness/AgentHarness.csproj
  -->
  <ItemGroup>
    <Compile Remove="AgentHarness/**/*.cs" />
    <Compile Remove="AgentLoopEndpoint/**/*.cs" />
    <!-- Same reason, and it bit immediately: tools/make_open_world_fixture/ is a standalone
         authoring tool on the Godot SDK, so building it writes a nested .godot/mono/temp/obj tree
         inside the project. That tree holds generated AssemblyInfo.cs files, and the **/*.cs glob
         swept them in, producing CS0579 "duplicate TargetFrameworkAttribute" on the next build of
         the engine. Excluding tools/** removes both the tool's own sources and its build output. -->
    <Compile Remove="tools/**/*.cs" />
  </ItemGroup>

  <!-- ASFDK-C# governance at intent ingress (AGENT-LOOP-001). Local project reference
       so the engine calls the real PromptDefense / RRT / Sleepwalker / TOI APIs.
       No transport, no Fusion dependency — engine-side only. -->
  <ItemGroup>
    <ProjectReference Include="..\..\asfdk-csharp\src\Asfdk\Asfdk.csproj" />
  </ItemGroup>
</Project>
